
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thapkrit-adventure",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thapkrit-adventure",
      "database_id": "90ace9d4-c4a1-4c22-889e-cda24f09a813"
    }
  ]
}
